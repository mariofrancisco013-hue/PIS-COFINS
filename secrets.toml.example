# Copie para .streamlit/secrets.toml localmente, ou cole em Manage app → Settings → Secrets no
# Streamlit Community Cloud. NÃO commitar o arquivo real (.streamlit/secrets.toml está no .gitignore).

# Connection string DIRETA de Postgres (Project Settings → Database → Connection string → URI no Supabase)
DATABASE_URL = "postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Project Settings → API no painel do Supabase
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "sua-anon-key-aqui"
